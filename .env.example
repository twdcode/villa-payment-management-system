# Which data layer the app runs against: "mock" | "supabase"
# Defaults to "mock" when unset or unrecognised — a typo can never silently
# point the app at an unfinished backend.
NEXT_PUBLIC_DATA_SOURCE=mock

# --- Supabase (Phase 2 onward) ---
# Project: zsnkgegdxbwwifnwopey · ap-south-1 (Mumbai)
NEXT_PUBLIC_SUPABASE_URL=https://zsnkgegdxbwwifnwopey.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# SERVER ONLY. Never prefix with NEXT_PUBLIC_ — that would ship it to the browser.
SUPABASE_SECRET_KEY=sb_secret_...

# Transaction pooler, port 6543. Drizzle needs this for multi-statement transactions;
# PostgREST cannot run them, which is why recordCollection goes through Drizzle.
DATABASE_URL=postgresql://postgres.zsnkgegdxbwwifnwopey:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
