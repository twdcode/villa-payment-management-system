# --- Supabase ---
# The app only ever talks to Supabase — there is no mock/demo mode. All of the
# variables below are required; the app will not run without them.
# Project: zsnkgegdxbwwifnwopey · ap-south-1 (Mumbai)
NEXT_PUBLIC_SUPABASE_URL=https://zsnkgegdxbwwifnwopey.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# SERVER ONLY. Never prefix with NEXT_PUBLIC_ — that would ship it to the browser.
SUPABASE_SECRET_KEY=sb_secret_...

# SESSION pooler, port 5432 — NOT the transaction pooler (6543). Drizzle needs a pooler
# for multi-statement transactions (PostgREST cannot run them, which is why
# recordCollection goes through Drizzle), but the transaction pooler HANGS when one
# client sends more concurrent queries than its pool size. See src/lib/db/client.ts for
# the measurements. Using 6543 here makes the app hang whenever two people use it at once.
DATABASE_URL=postgresql://postgres.zsnkgegdxbwwifnwopey:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# --- Phase 7: reminders + cron ---
# Checked by src/app/api/cron/reminders/route.ts against the Authorization header Vercel
# Cron sends. Without this the endpoint is a public URL anyone could hit.
CRON_SECRET=

# src/lib/reminders/send.ts sends through Resend once both of these are set — without
# either, sendReminderEmail throws (a real send failure, not a silent no-op).
RESEND_API_KEY=

# The verified Resend sender. A sandbox account (no verified domain) must use
# onboarding@resend.dev, which itself only delivers to that Resend account's own
# address — real customers cannot receive email until a real domain is verified in the
# Resend dashboard. This is deliberately an env var, not a workspace setting: it is
# constrained by which domain Resend has actually verified, not a business preference.
CONTACT_FROM_EMAIL=onboarding@resend.dev

# --- Phase 8: deploy ---
# Absolute origin of the deployment. Supabase builds password-reset and invite links
# against this, so a wrong value sends users to the wrong host.
NEXT_PUBLIC_SITE_URL=https://your-deployment.vercel.app
